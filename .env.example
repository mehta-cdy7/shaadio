# Copy to .env.local and fill in. Never commit real values.
# Validated by src/server/env.ts. Separate credentials per environment (SYSTEM_DESIGN §78).

# --- Core: required now ---
# Must be a replica set (Atlas, or a local single-node replica set): transactions need one.
MONGODB_URI=mongodb://localhost:27017/shaadioo-dev?replicaSet=rs0
APP_ORIGIN=http://localhost:3000

# --- Later increments: not read yet ---
# SESSION_SECRET=          # >= 32 random bytes; HMAC key for session/reset/invite token hashes
# CRON_SECRET=             # Bearer secret for /api/internal/* (API_DESIGN §2.3)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=shaadioo-dev
# MEDIA_BASE_URL=          # media domain serving R2 objects by key (API-11)
# RESEND_API_KEY=
# EMAIL_FROM=
# GOOGLE_PLACES_API_KEY=   # server-side only
