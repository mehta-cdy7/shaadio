# Copy to .env.local and fill in. Never commit real values.
# Validated by src/server/env.ts. Separate credentials per environment (SYSTEM_DESIGN §78).

# --- Core: required now ---
# Must be a replica set (Atlas, or a local single-node replica set): transactions need one.
MONGODB_URI=mongodb://localhost:27017/shaadioo-dev?replicaSet=rs0
APP_ORIGIN=http://localhost:3000
# >= 32 random characters; HMAC key for session/reset/invite token hashes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Cloudflare R2 (photo storage). Leave all five empty to switch storage off; set all five or none.
# Token: R2 → Manage API tokens → Object Read & Write, scoped to this one bucket. Check: pnpm r2:check
R2_ACCOUNT_ID=            # 32-character Cloudflare account id
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=           # shaadio-dev (production: shaadio-prod)
MEDIA_BASE_URL=           # public bucket domain, no trailing slash, e.g. https://media.shaadio.in

RESEND_API_KEY=           # member invitation emails (slice 10); optional in dev: invites still return a link
EMAIL_FROM=               # e.g. "Shaadio <hello@your-verified-domain>"
# EMAIL_DAILY_LIMIT=100           # provider quota per UTC day (Resend free plan)
# EMAIL_TRANSACTIONAL_RESERVE=20  # kept for member invites and password resets
# >= 32 characters; Vercel Cron sends it as "Authorization: Bearer …" to /api/internal/*
CRON_SECRET=
# --- Later increments: not read yet ---
# GOOGLE_PLACES_API_KEY=   # server-side only
